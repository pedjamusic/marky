file(READ "${CORPUS}" corpus)
string(JSON version GET "${corpus}" version)
string(JSON count LENGTH "${corpus}" fixtures)
if(NOT version EQUAL 1 OR count LESS 1)
    message(FATAL_ERROR "Unsupported or empty Markdown corpus")
endif()

math(EXPR last "${count} - 1")
string(RANDOM LENGTH 16 suffix)
set(input_file "${INPUT_DIR}/markdown-corpus-${suffix}.md")
set(failures 0)
foreach(index RANGE 0 ${last})
    string(JSON fixture GET "${corpus}" fixtures ${index})
    string(JSON id GET "${fixture}" id)
    string(JSON source GET "${fixture}" input)
    string(JSON expected GET "${fixture}" blocks)
    file(WRITE "${input_file}" "${source}")
    execute_process(
        COMMAND "${PROBE}" "${input_file}"
        RESULT_VARIABLE status
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error
    )
    if(NOT status STREQUAL "0")
        message("FAIL ${id}: probe returned ${status}\n${error}")
        math(EXPR failures "${failures} + 1")
        continue()
    endif()
    string(JSON actual GET "${output}")
    if(NOT actual STREQUAL expected)
        message("FAIL ${id}\nExpected: ${expected}\nActual: ${actual}")
        math(EXPR failures "${failures} + 1")
    endif()
endforeach()
file(REMOVE "${input_file}")
if(failures)
    message(FATAL_ERROR "${failures} of ${count} Markdown fixtures failed")
endif()
message(STATUS "All ${count} Markdown fixtures matched")
